# Copy to .env.local (local) or add in Vercel → Project → Settings → Environment Variables.
# Values can instead be pasted directly into src/config/site.ts.
# Leave a value empty if it is not yet known — the site shows an honest "Coming soon" state.

# Required before launch
NEXT_PUBLIC_NOTION_FORM_URL=
NEXT_PUBLIC_WHATSAPP_COMMUNITY_URL=

# Production URL, e.g. https://example.org — enables canonical URL, sitemap and search indexing.
# Leave empty on preview deployments so they are not indexed.
NEXT_PUBLIC_SITE_URL=

# Optional — set only once confirmed
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_PRIVACY_NOTICE_URL=
NEXT_PUBLIC_TERMS_URL=
