# Copy to .env.local (local) or add in Vercel → Project → Settings → Environment Variables.
# Values can instead be pasted directly into src/config/site.ts.
# Leave a value empty to keep the default in src/config/site.ts.

# Server-only. Notion integration token for the /join form, which saves applications to the
# "Contributor Applications" database. Create it at https://www.notion.so/profile/integrations
# and connect the integration to that database (⋯ → Connections). Never prefix with NEXT_PUBLIC_.
NOTION_TOKEN=
# Optional: override the Notion data source the form writes to.
NOTION_CONTRIBUTORS_DATA_SOURCE_ID=

# Public Notion form, shown on /join only as a fallback while NOTION_TOKEN is not set.
NEXT_PUBLIC_NOTION_FORM_URL=
# WhatsApp Community invitation. WhatsApp buttons are hidden until set.
NEXT_PUBLIC_WHATSAPP_COMMUNITY_URL=

# Defaults: https://sasarjan.com and info@sasarjan.com
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_CONTACT_EMAIL=

# Optional
NEXT_PUBLIC_PRIVACY_NOTICE_URL=
NEXT_PUBLIC_TERMS_URL=
